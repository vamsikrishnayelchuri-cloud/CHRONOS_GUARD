# CHRONOS-GUARD ENVIRONMENT CONFIGURATION
# Copy to .env and customize as needed

# 1. Google Gemini API (Server-Side Adapter)
# When left empty, Chronos-Guard gracefully falls back to deterministic demonstration rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. PayPal Sandbox REST API (Server-Side OAuth Credentials)
# When left empty, Chronos-Guard runs in simulated sandbox mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# 3. Database & Storage
DATABASE_URL=sqlite:///./chronos_guard.db
DATA_DIR=./data_store

# 4. Simulation & Benchmark Defaults
DEFAULT_RANDOM_SEED=42
DEFAULT_LABEL_DELAY_STEPS=7
